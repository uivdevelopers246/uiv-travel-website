<mjml>
  <mj-body background-color="#f6f3ee">
    <mj-section background-color="#ffffff" padding="28px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#16251f">United IV receipt</mj-text>
        <mj-text font-size="15px" color="#24342e">Hi {{recipientName}}, your order is confirmed.</mj-text>
        <mj-table color="#24342e" font-size="14px">
          <tr><td>Order</td><td align="right">{{order.id}}</td></tr>
          <tr><td>Status</td><td align="right">{{order.status}}</td></tr>
          <tr><td>Total</td><td align="right">{{formatCurrency order.totalCents order.currency}}</td></tr>
        </mj-table>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
